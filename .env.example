# =============================================================================
# SGR · Ejemplo de configuración (copiar a .env y completar). SIN SECRETOS REALES.
# =============================================================================

# --- Django ---
DJANGO_DEBUG=0
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Dominio o IP pública de la instancia EC2 (separados por coma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ec2-x-x-x-x.compute.amazonaws.com
# Necesario si se accede por HTTPS o por un dominio distinto (con esquema)
DJANGO_CSRF_TRUSTED_ORIGINS=http://ec2-x-x-x-x.compute.amazonaws.com
# Solo cuando el sitio se sirve por HTTPS (certificado en nginx o ALB):
COOKIES_SEGURAS=0
FORZAR_HTTPS=0
HSTS_SEGUNDOS=0
SGR_VERSION=v2.0.0-entrega2

# --- Base de datos (AWS RDS MySQL 8 o MySQL/MariaDB en la EC2) ---
DB_ENGINE=mysql
DB_NAME=sgr
DB_USER=sgr
DB_PASSWORD=cambiar
DB_HOST=sgr-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306

# --- Correo para el código de recuperación (SMTP: Amazon SES o Gmail) ---
# Sin EMAIL_HOST el correo se imprime en el log (solo desarrollo).
# Amazon SES: email-smtp.us-east-1.amazonaws.com, puerto 587, credenciales SMTP de SES.
# Gmail: smtp.gmail.com, puerto 587, usuario Gmail y "contraseña de aplicación".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_FROM=SGR La Serena <no-responder@su-dominio.cl>

# --- Seguridad de acceso y recuperación (valores referenciales del diseño) ---
SESSION_MINUTOS=60
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=5
RECUPERACION_VIGENCIA_MINUTOS=10
RECUPERACION_ESPERA_REENVIO_SEG=45
RECUPERACION_MAX_INTENTOS=5
RECUPERACION_MAX_REENVIOS=3
RECUPERACION_MAX_SOLICITUDES_HORA=3

# --- Datos de prueba (solo ambientes de evaluación) ---
# Debe cumplir la política de claves (8+ caracteres, mayúscula, minúscula, número y símbolo)
SGR_CLAVE_DEMO=Cambiar.Esta1
