# =============================================================================
# SGR · Configuración de DESARROLLO LOCAL (opcional)
# El proyecto funciona sin .env. Copie este archivo a .env solo si quiere
# cambiar algo (por ejemplo, usar MySQL local o enviar correos reales).
# Para AWS use deploy/env.produccion.example.
# =============================================================================
DJANGO_DEBUG=1
DB_ENGINE=sqlite

# --- MySQL local (opcional): cambie DB_ENGINE=mysql y complete ---
# DB_NAME=sgr
# DB_USER=sgr
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Correo real para el código de recuperación (opcional) ---
# Sin EMAIL_HOST el código se muestra en la consola donde corre el servidor.
# Gmail: requiere verificación en 2 pasos y una "contraseña de aplicación".
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=sucorreo@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion
# EMAIL_FROM=SGR La Serena <sucorreo@gmail.com>

# --- Clave de los usuarios de prueba (por defecto Serena.2026) ---
# SGR_CLAVE_DEMO=Serena.2026
